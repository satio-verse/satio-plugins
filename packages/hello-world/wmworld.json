{
  "id": "hello-world",
  "name": "Hello World（示例世界）",
  "description": "最小的空间插件示例：一个只读的示例房间，演示 wmworld.json 怎么写。",
  "plugin": {
    "schema": 2,
    "version": "0.1.0",
    "author": "satio-verse",
    "license": "Apache-2.0",
    "host": ">=0.1",
    "tier": "panel",
    "permissions": {
      "local": [],
      "notify": false
    },
    "panel": {
      "entry": "spectate.html",
      "tools": [
        "hello_look"
      ]
    },
    "budget": {
      "minutes_per_day": 30
    },
    "world": {
      "kind": "space",
      "prefix": "hello",
      "events": [
        {
          "type": "hello_entered",
          "sense": "saw",
          "urgency": "batch",
          "fields": [
            "who",
            "distance_bucket"
          ]
        },
        {
          "type": "hello_left",
          "sense": "saw",
          "urgency": "piggyback",
          "fields": [
            "who"
          ]
        },
        {
          "type": "hello_moved",
          "sense": "saw",
          "urgency": "piggyback",
          "fields": [
            "who",
            "distance_bucket"
          ]
        },
        {
          "type": "hello_said",
          "sense": "heard",
          "urgency": "now",
          "fields": [
            "who"
          ]
        },
        {
          "type": "hello_act_result",
          "sense": "receipt",
          "urgency": "now"
        }
      ],
      "actions": [
        {
          "name": "hello_walk",
          "kind": "act",
          "outward": true,
          "receipt": "hello_act_result",
          "params": {
            "direction": {
              "type": "enum",
              "required": true,
              "values": [
                "left",
                "right",
                "up",
                "down"
              ]
            }
          },
          "why": "在示例房间里走一步"
        },
        {
          "name": "hello_say",
          "kind": "act",
          "outward": true,
          "receipt": "hello_act_result",
          "params": {
            "text": {
              "type": "string",
              "required": true,
              "max_len": 200
            }
          },
          "why": "对房间里的人说一句话"
        },
        {
          "name": "hello_wave",
          "kind": "act",
          "outward": true,
          "receipt": "hello_act_result",
          "params": {},
          "why": "挥手"
        },
        {
          "name": "hello_look",
          "kind": "query",
          "why": "看一眼房间里有谁、离多远"
        }
      ],
      "perception": {
        "visible": [
          "who",
          "distance_bucket",
          "own_position"
        ],
        "hidden": [
          "all_positions",
          "room_roster"
        ],
        "twin_fixtures": [
          "fixtures/hello-far-pet.json"
        ]
      },
      "env_prompt": "ENV_PROMPT.md",
      "leave": {
        "ack_timeout_s": 3
      },
      "spectate": {
        "panel": "spectate.html"
      }
    }
  }
}
